<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Message Board</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
<div class="page">

  <!-- Masthead -->
  <header class="masthead">
    <h1 class="masthead-title">Message<em>Board</em></h1>
    <span class="masthead-count"><%= messages.length %> posts</span>
  </header>

  <!-- Toolbar: sort tabs + new post button -->
  <div class="toolbar">
    <nav class="sort-tabs" aria-label="Sort posts by">
      <%
        const sorts = [
          { key: 'hot',           label: 'Hot',           title: 'Trending — score decays with age' },
          { key: 'new',           label: 'New',           title: 'Most recently posted' },
          { key: 'top',           label: 'Top',           title: 'Most liked of all time' },
          { key: 'rising',        label: 'Rising',        title: 'Recent posts gaining likes fast' },
          { key: 'controversial', label: 'Controversial', title: 'High likes and high flags' },
        ];
      %>
      <% sorts.forEach(function(s) { %>
        <a
          href="/?sort=<%= s.key %>"
          class="sort-tab <%= sort === s.key ? 'active' : '' %>"
          title="<%= s.title %>"
        ><%= s.label %></a>
      <% }); %>
    </nav>

    <a href="/new" class="btn-new">Post something</a>
  </div>

  <!-- Rate-limit notice -->
  <% if (notice) { %>
    <div class="notice"><%= notice %></div>
  <% } %>

  <!-- Posts -->
  <% if (messages && messages.length > 0) { %>
    <% messages.forEach(function(msg) {
         const isDemoted = msg.flags >= 5;
    %>
    <article class="post <%= isDemoted ? 'demoted' : '' %>">

      <!-- Like / vote column -->
      <div class="vote-col">
        <button
          class="like-btn"
          data-liked="false"
          data-id="<%= msg.id %>"
          aria-label="Like this post"
        >♡</button>
        <span class="like-count"><%= msg.likes %></span>
      </div>

      <!-- Content -->
      <div>
        <div class="post-author"><%= msg.user %></div>
        <a href="/message/<%= msg.id %>" class="post-text"><%= msg.text %></a>

        <div class="post-footer">
          <span class="post-time"><%= formatDateTime(msg.added) %></span>

          <form class="flag-form" method="POST" action="/flag/<%= msg.id %>?sort=<%= sort %>">
            <button
              type="submit"
              class="flag-btn"
              onclick="return confirm('Flag this post as inappropriate?')"
            >
              ⚑
              <% if (msg.flags > 0) { %>
                <span class="flag-count-badge <%= msg.flags >= 3 ? 'elevated' : '' %>">
                  <%= msg.flags %>
                </span>
              <% } else { %>
                Flag
              <% } %>
            </button>
          </form>

          <% if (isDemoted) { %>
            <span class="demoted-tag">Reported</span>
          <% } %>
        </div>
      </div>

    </article>
    <% }); %>
  <% } else { %>
    <div class="empty">
      <p class="empty-title">Nothing here yet.</p>
      <p>Be the first to post something.</p>
    </div>
  <% } %>

</div>

<script>
  document.querySelectorAll('.like-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      const id = btn.dataset.id;
      const liked = btn.dataset.liked === 'true';
      const countEl = btn.closest('.vote-col').querySelector('.like-count');

      try {
        const res = await fetch(`/like/${id}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: `liked=${liked}`,
        });

        if (res.status === 429) {
          btn.style.opacity = '0.3';
          setTimeout(() => btn.style.opacity = '', 800);
          return;
        }

        const data = await res.json();
        countEl.textContent = data.likes;
        btn.dataset.liked = data.liked;
        btn.textContent = data.liked ? '♥' : '♡';
        btn.classList.toggle('liked', data.liked);
      } catch (e) {
        console.error(e);
      }
    });
  });
</script>
</body>
</html>
