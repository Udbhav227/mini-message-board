<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>New post</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
<div class="page">

  <div class="form-masthead">
    <h1 class="form-title">New post</h1>
    <p class="form-sub">Keep it civil. Max 120 characters.</p>
  </div>

  <% if (locals.errors && errors.length > 0) { %>
    <ul class="errors">
      <% errors.forEach(e => { %>
        <li><%= e.msg %></li>
      <% }); %>
    </ul>
  <% } %>

  <form method="POST" action="/new">

    <div class="form-group">
      <label class="form-label" for="messageUser">Your name</label>
      <input
        class="form-input"
        type="text"
        id="messageUser"
        name="messageUser"
        placeholder="e.g. Ash"
        autocomplete="off"
        maxlength="50"
        required
      >
    </div>

    <div class="form-group">
      <label class="form-label" for="messageText">Message</label>
      <textarea
        class="form-textarea"
        id="messageText"
        name="messageText"
        rows="3"
        placeholder="What's on your mind?"
        maxlength="180"
        required
      ></textarea>
      <div class="char-hint" id="char-hint">120 characters remaining</div>
    </div>

    <button type="submit" class="btn-submit">Post</button>
  </form>

  <a href="/" class="nav-back">← Back to board</a>

</div>

<script>
  const ta = document.getElementById('messageText');
  const hint = document.getElementById('char-hint');

  ta.addEventListener('input', () => {
    const left = 120 - ta.value.length;
    hint.textContent = `${left} character${left === 1 ? '' : 's'} remaining`;
    hint.className = 'char-hint' + (left <= 20 ? ' warn' : '') + (left <= 0 ? ' over' : '');
  });
</script>
</body>
</html>
