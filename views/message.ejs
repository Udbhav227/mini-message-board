<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= message.user %>'s post</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
<div class="page">

  <a href="/" class="detail-nav">← Back to board</a>

  <div class="detail-wrap">
    <div class="detail-author"><%= message.user %></div>
    <p class="detail-body"><%= message.text %></p>

    <div class="detail-footer">
      <span class="detail-stat"><strong><%= message.likes %></strong> likes</span>
      <span class="detail-stat"><strong><%= message.flags || 0 %></strong> reports</span>
      <span class="detail-stat"><%= formatDateTime(message.added) %></span>

      <form method="POST" action="/flag/<%= message.id %>" style="margin-left: auto;">
        <button
          type="submit"
          class="btn-flag-outline"
          onclick="return confirm('Report this post?')"
        >
          &#9873; Report
        </button>
      </form>
    </div>
  </div>

</div>
</body>
</html>
